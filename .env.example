# Bigship API credentials (required for integration tests)
BIGSHIP_USER_NAME=your-email@example.com
BIGSHIP_PASSWORD=your-password
BIGSHIP_ACCESS_KEY=your-access-key
BIGSHIP_BASE_URL=https://api.bigship.in

# Set to "true" to run write tests (add order, manifest, cancel)
# These create real orders — use with caution
BIGSHIP_TEST_WRITE=false
