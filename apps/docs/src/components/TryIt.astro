---
import PlaygroundButton from './PlaygroundButton.astro';

interface Props {
  example: string;
  description?: string;
}

const { example, description = 'Try this example live in the interactive playground.' } = Astro.props;
---

<aside style="border: 1px solid var(--sl-color-accent); border-radius: 0.5rem; padding: 1rem; margin: 1.5rem 0; background: var(--sl-color-accent-low);">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <strong style="color: var(--sl-color-accent-high);">Try it live</strong>
      <p style="margin: 0.25rem 0 0; color: var(--sl-color-gray-2); font-size: 0.875rem;">
        {description}
      </p>
    </div>
    <PlaygroundButton example={example} />
  </div>
</aside>
