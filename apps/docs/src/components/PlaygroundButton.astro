---
interface Props {
  example: string;
  label?: string;
}

const { example, label = 'Try in Playground' } = Astro.props;
---

<a
  href={`/playground?example=${example}`}
  class="sl-link-card"
  style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: var(--sl-color-accent); color: var(--sl-color-white); border-radius: 0.375rem; text-decoration: none; font-weight: 600; font-size: 0.875rem;"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <polygon points="5 3 19 12 5 21 5 3" />
  </svg>
  {label}
</a>
